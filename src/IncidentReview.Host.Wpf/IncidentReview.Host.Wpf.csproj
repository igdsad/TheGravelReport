<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>IncidentReview.Host.Wpf</AssemblyName>
    <RootNamespace>IncidentReview.Host.Wpf</RootNamespace>
    <ApplicationIcon>../../assets/branding/favicon-simplified.ico</ApplicationIcon>
    <AssemblyTitle>GravelReview</AssemblyTitle>
    <Product>GravelReview</Product>
    <Version>0.0.3-alpha</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../IncidentReview.Application/IncidentReview.Application.csproj" />
    <ProjectReference Include="../IncidentReview.EventSync.Http/IncidentReview.EventSync.Http.csproj" />
    <ProjectReference Include="../IncidentReview.Desktop.Wpf/IncidentReview.Desktop.Wpf.csproj" />
    <ProjectReference Include="../IncidentReview.Store.Sqlite/IncidentReview.Store.Sqlite.csproj" />
    <ProjectReference Include="../IncidentReview.Iracing/IncidentReview.Iracing.csproj" />
    <ProjectReference Include="../IncidentReview.Application.Contracts/IncidentReview.Application.Contracts.csproj" />
    <ProjectReference Include="../IncidentReview.Store.Contracts/IncidentReview.Store.Contracts.csproj" />
    <ProjectReference Include="../IncidentReview.Results/IncidentReview.Results.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../vendor/third_party/iracing-sdk-1.20/NOTICE.md"
          Link="THIRD-PARTY-NOTICES/iracing-sdk-1.20.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
