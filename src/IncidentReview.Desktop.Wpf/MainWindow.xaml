<Window x:Class="IncidentReview.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GravelReview"
        Width="1120"
        Height="720"
        MinWidth="800"
        MinHeight="520"
        AutomationProperties.AutomationId="IncidentReview.MainWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="16,14,16,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="GravelReview" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#555555"
                           Text="{Binding State.ActiveDriverName}"
                           Visibility="{Binding State.HasActiveDriver, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Padding="12,6"
                        AutomationProperties.AutomationId="IncidentReview.Refresh"
                        AutomationProperties.Name="Refresh incident log"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
                <Button Margin="0,0,8,0" Padding="12,6"
                        AutomationProperties.AutomationId="IncidentReview.ToggleMonitoring"
                        AutomationProperties.Name="Start or stop live incident updates"
                        Command="{Binding ToggleMonitoringCommand}"
                        Content="{Binding State.MonitorActionText}" />
                <Button Padding="12,6"
                        AutomationProperties.AutomationId="IncidentReview.Cancel"
                        AutomationProperties.Name="Cancel current operation"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="16,12,16,10"
                BorderBrush="#B8B8B8" BorderThickness="1" CornerRadius="4">
            <Grid>
                <DataGrid x:Name="IncidentGrid"
                          AutomationProperties.AutomationId="IncidentReview.Incidents"
                          AutomationProperties.Name="Chronological incident log"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          ItemsSource="{Binding State.Incidents}"
                          SelectedItem="{Binding SelectedIncident}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="OnIncidentActivated">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recorded" Binding="{Binding ObservedAtText}" Width="145" />
                        <DataGridTemplateColumn Header="Incident ID" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="4,0"
                                               Text="{Binding IncidentIdText}"
                                               ToolTip="{Binding FullIncidentIdText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Replay time" Binding="{Binding ReplayTime}" Width="105" />
                        <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="135" />
                        <DataGridTextColumn Header="Lap" Binding="{Binding Lap}" Width="60" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        <DataGridTemplateColumn Header="Review" Width="*" MinWidth="225">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="3,2" Padding="9,3"
                                                AutomationProperties.Name="Review two seconds before this incident"
                                                Command="{Binding DataContext.ReviewBeforeCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Content="-2 sec" />
                                        <Button Margin="3,2" Padding="9,3"
                                                AutomationProperties.Name="Review at this incident"
                                                Command="{Binding DataContext.ReviewAtCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Content="0 sec" />
                                        <Button Margin="3,2" Padding="9,3"
                                                AutomationProperties.Name="Review two seconds after this incident"
                                                Command="{Binding DataContext.ReviewAfterCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Content="+2 sec" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="IncidentReview.EmptyState"
                           AutomationProperties.Name="Incident log status"
                           FontSize="16" Foreground="#666666"
                           Text="{Binding State.EmptyMessage}"
                           Visibility="{Binding State.ShowsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Expander Grid.Row="2" Margin="16,0,16,8"
                  AutomationProperties.AutomationId="IncidentReview.Advanced"
                  Header="Advanced"
                  IsExpanded="False">
            <Border Margin="0,7,0,0" Padding="10"
                    Background="#F7F7F7" BorderBrush="#D3D3D3" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,5"
                               FontWeight="SemiBold" Text="Event stream" />
                    <ListBox x:Name="EventLogList"
                             Grid.Row="1"
                             AutomationProperties.AutomationId="IncidentReview.EventLog"
                             AutomationProperties.Name="Application event stream"
                             ItemsSource="{Binding State.EventLog}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <TextBlock DockPanel.Dock="Left" Width="160"
                                               Foreground="#666666" Text="{Binding Timestamp}" />
                                    <TextBlock Text="{Binding Message}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#222222" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#A31515" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Grid.Row="2" Margin="0,10" />

                    <WrapPanel Grid.Row="3" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Text="Camera" />
                        <ComboBox Width="220" Margin="0,0,12,0"
                                  AutomationProperties.AutomationId="IncidentReview.Camera"
                                  AutomationProperties.Name="Preferred replay camera"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding State.CameraChoices}"
                                  SelectedItem="{Binding SelectedCameraChoice, Mode=TwoWay}" />
                        <Button Padding="12,4"
                                AutomationProperties.AutomationId="IncidentReview.SavePreferences"
                                AutomationProperties.Name="Save preferred replay camera"
                                Command="{Binding SavePreferencesCommand}"
                                Content="Save" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Expander>

        <StatusBar Grid.Row="3" AutomationProperties.AutomationId="IncidentReview.StatusBar">
            <StatusBarItem Padding="0" HorizontalContentAlignment="Stretch">
                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type StatusBar}}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="6,0"
                               AutomationProperties.AutomationId="IncidentReview.ConnectionStatus"
                               AutomationProperties.Name="Simulator connection status"
                               FontWeight="SemiBold" Text="{Binding State.ConnectionStatus}" />
                    <Separator Grid.Column="1" />
                    <TextBlock Grid.Column="2" Margin="8,0"
                               Text="{Binding State.StatusDetail}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding State.StatusDetail}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#333333" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State.HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#A31515" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Separator Grid.Column="3" />
                    <TextBlock Grid.Column="4" Margin="8,0" Text="{Binding State.MonitoringStatus}" />
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
