<Window x:Class="IncidentReview.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GravelReview"
        Width="1120"
        Height="720"
        MinWidth="800"
        MinHeight="620"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AutomationProperties.AutomationId="IncidentReview.MainWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IncidentReview.Desktop.Wpf;component/Themes/Base.xaml" />
                <!-- ThemeController replaces only this palette dictionary at runtime. -->
                <ResourceDictionary Source="pack://application:,,,/IncidentReview.Desktop.Wpf;component/Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="12,12,12,0"
                Padding="12,8"
                Style="{StaticResource AppToolbarCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="43"
                           Height="43"
                           Margin="0,0,10,0"
                           AutomationProperties.Name="GravelReview logo"
                           IsHitTestVisible="False"
                           SnapsToDevicePixels="True"
                           Source="pack://application:,,,/IncidentReview.Desktop.Wpf;component/Assets/GravelReviewLogo.png"
                           Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource AppTitleTextStyle}"
                                       Text="GravelReview" />
                            <Border Margin="9,3,0,2"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource App.Accent.Soft}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="iRacing" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="1,1,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding State.HasActiveDriver, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource AppMutedTextStyle}"
                                       FontSize="11"
                                       Text="Active driver" />
                            <TextBlock Margin="5,0,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding State.ActiveDriverName}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,7,0"
                            AutomationProperties.AutomationId="IncidentReview.Refresh"
                            AutomationProperties.Name="Refresh incident log"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Style="{StaticResource AppToolbarButtonStyle}" />
                    <Button Margin="0,0,7,0"
                            AutomationProperties.AutomationId="IncidentReview.ToggleMonitoring"
                            AutomationProperties.Name="Start or stop live incident updates"
                            Command="{Binding ToggleMonitoringCommand}"
                            Content="{Binding State.MonitorActionText}"
                            Style="{StaticResource AppToolbarButtonStyle}" />
                    <Button Margin="0,0,7,0"
                            AutomationProperties.AutomationId="IncidentReview.CreateCustomEvent"
                            AutomationProperties.Name="Create a custom review event at the current race position"
                            Command="{Binding CreateCustomEventCommand}"
                            Content="Mark event"
                            Style="{StaticResource AppAccentButtonStyle}" />
                    <Button AutomationProperties.AutomationId="IncidentReview.Cancel"
                            AutomationProperties.Name="Cancel current operation"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource AppToolbarButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12,10,12,8"
                ClipToBounds="True"
                Style="{StaticResource AppCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl Grid.RowSpan="2">
                    <TabItem Header="Incidents">
                        <Grid>
                <DataGrid x:Name="IncidentGrid"
                          AlternationCount="2"
                          AutomationProperties.AutomationId="IncidentReview.Incidents"
                          AutomationProperties.Name="Chronological incident log"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          ItemsSource="{Binding State.Incidents}"
                          SelectedItem="{Binding SelectedIncident}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="OnIncidentActivated">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recorded at"
                                            Binding="{Binding ObservedAtText}"
                                            SortMemberPath="ObservedAt"
                                            Width="214" />
                        <DataGridTemplateColumn Header="Incident ID" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IncidentIdText}"
                                               ToolTip="{Binding FullIncidentIdText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Replay time"
                                            Binding="{Binding ReplayTime}"
                                            Width="102" />
                        <DataGridTextColumn Header="Points"
                                            Binding="{Binding Points}"
                                            Width="125" />
                        <DataGridTextColumn Header="Lap"
                                            Binding="{Binding Lap}"
                                            Width="56" />
                        <DataGridTextColumn Header="Driver"
                                            Binding="{Binding DriverText}"
                                            SortMemberPath="DriverText"
                                            Width="180" />
                        <DataGridTemplateColumn Header="Review" Width="*" MinWidth="225">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Margin="3,2"
                                                AutomationProperties.Name="Review two seconds before this incident"
                                                Command="{Binding DataContext.ReviewBeforeCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Content="-2 sec"
                                                Style="{StaticResource AppCompactButtonStyle}" />
                                        <Button Margin="3,2"
                                                AutomationProperties.Name="Review at this incident"
                                                Command="{Binding DataContext.ReviewAtCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Content="0 sec"
                                                Style="{StaticResource AppCompactAccentButtonStyle}" />
                                        <Button Margin="3,2"
                                                AutomationProperties.Name="Review two seconds after this incident"
                                                Command="{Binding DataContext.ReviewAfterCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Content="+2 sec"
                                                Style="{StaticResource AppCompactButtonStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="IncidentReview.EmptyState"
                            AutomationProperties.Name="Incident log status"
                            IsHitTestVisible="False"
                            Visibility="{Binding State.ShowsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path Width="23"
                          Height="23"
                          Margin="0,0,0,8"
                          Data="M 2,3 L 14,3 L 14,15 L 2,15 Z M 5,7 L 11,7 M 5,10 L 10,10"
                          Stroke="{DynamicResource App.Text.Muted}"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.4"
                          Stretch="Uniform" />
                    <TextBlock MaxWidth="430"
                               HorizontalAlignment="Center"
                               Style="{StaticResource AppSecondaryTextStyle}"
                               FontSize="14"
                               Text="{Binding State.EmptyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Custom events">
                        <Grid>
                            <DataGrid AutomationProperties.AutomationId="IncidentReview.CustomEvents"
                                      AutomationProperties.Name="Custom review events"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding State.CustomEvents}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Recorded"
                                                        Binding="{Binding OccurredAtText}"
                                                        Width="142" />
                                    <DataGridTemplateColumn Header="Event ID" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CustomEventIdText}"
                                                           ToolTip="{Binding FullCustomEventIdText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Replay time"
                                                        Binding="{Binding ReplayTime}"
                                                        Width="102" />
                                    <DataGridTextColumn Header="Submitted by"
                                                        Binding="{Binding Submitter}"
                                                        Width="160" />
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding SynchronizationStatus}"
                                                        Width="120" />
                                    <DataGridTemplateColumn Header="Review" Width="*" MinWidth="225">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Margin="3,2"
                                                            AutomationProperties.Name="Review two seconds before this custom event"
                                                            Command="{Binding DataContext.ReviewCustomEventBeforeCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="-2 sec"
                                                            Style="{StaticResource AppCompactButtonStyle}" />
                                                    <Button Margin="3,2"
                                                            AutomationProperties.Name="Review at this custom event"
                                                            Command="{Binding DataContext.ReviewCustomEventAtCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="0 sec"
                                                            Style="{StaticResource AppCompactAccentButtonStyle}" />
                                                    <Button Margin="3,2"
                                                            AutomationProperties.Name="Review two seconds after this custom event"
                                                            Command="{Binding DataContext.ReviewCustomEventAfterCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="+2 sec"
                                                            Style="{StaticResource AppCompactButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock MaxWidth="480"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="{Binding State.CustomEventEmptyMessage}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AppSecondaryTextStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.HasCustomEvents}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Expander Grid.Row="2"
                  Margin="12,0,12,8"
                  AutomationProperties.AutomationId="IncidentReview.Advanced"
                  Header="Advanced"
                  IsExpanded="False">
            <Border Margin="0,6,0,0"
                    Padding="10"
                    Style="{StaticResource AppCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="1,0,0,6"
                               Style="{StaticResource AppSectionTitleTextStyle}"
                               Text="Event stream" />
                    <ListBox x:Name="EventLogList"
                             Grid.Row="1"
                             AutomationProperties.AutomationId="IncidentReview.EventLog"
                             AutomationProperties.Name="Application event stream"
                             ItemsSource="{Binding State.EventLog}"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinWidth="520" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Width="150"
                                               Style="{StaticResource AppMutedTextStyle}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               Text="{Binding Timestamp}" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Grid.Row="2" Margin="0,10" />

                    <WrapPanel Grid.Row="3" VerticalAlignment="Center">
                        <TextBlock Margin="1,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource AppSectionTitleTextStyle}"
                                   Text="Replay camera" />
                        <ComboBox Width="220"
                                  Margin="0,0,8,0"
                                  AutomationProperties.AutomationId="IncidentReview.Camera"
                                  AutomationProperties.Name="Preferred replay camera"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding State.CameraChoices}"
                                  SelectedItem="{Binding SelectedCameraChoice, Mode=TwoWay}" />
                        <Button AutomationProperties.AutomationId="IncidentReview.SavePreferences"
                                AutomationProperties.Name="Save preferred replay camera"
                                Command="{Binding SavePreferencesCommand}"
                                Content="Save"
                                Style="{StaticResource AppToolbarButtonStyle}" />
                    </WrapPanel>

                    <Separator Grid.Row="4" Margin="0,10" />

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="1,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource AppSectionTitleTextStyle}"
                                   Text="Event marker" />
                        <TextBox Grid.Column="1"
                                 Margin="0,0,12,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="IncidentReview.CustomEventSubmitter"
                                 AutomationProperties.Name="Name attached to custom events"
                                 MaxLength="128"
                                 Text="{Binding CustomEventSubmitter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Your name as it will appear to the reviewer" />
                        <TextBlock Grid.Column="2"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Shortcut" />
                        <TextBox Grid.Column="3"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="IncidentReview.CustomEventKey"
                                 AutomationProperties.Name="Keyboard shortcut for custom events"
                                 MaxLength="64"
                                 Text="{Binding CustomEventKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Map a steering-wheel button to this key or key combination" />
                        <Button Grid.Column="4"
                                AutomationProperties.AutomationId="IncidentReview.SaveCustomEventSettings"
                                AutomationProperties.Name="Save custom event settings"
                                Command="{Binding SaveCustomEventSettingsCommand}"
                                Content="Save event settings"
                                Style="{StaticResource AppToolbarButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="1,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource AppSectionTitleTextStyle}"
                                   Text="Join code" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="IncidentReview.EventJoinCode"
                                 AutomationProperties.Name="Custom event session join code"
                                 MaxLength="4096"
                                 Text="{Binding EventJoinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Paste a host's code, then save event settings; clear it for local-only events" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="IncidentReview.CopyJoinCode"
                                AutomationProperties.Name="Copy the custom event join code"
                                Click="OnCopyJoinCode"
                                Content="Copy"
                                Style="{StaticResource AppToolbarButtonStyle}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="1,8,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource AppSectionTitleTextStyle}"
                                   Text="Host address" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,8,8,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="IncidentReview.EventHostAddress"
                                 AutomationProperties.Name="Address for hosting a custom event session"
                                 Text="{Binding EventHostAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The HTTP address included in the join code" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,8,0,0"
                                AutomationProperties.AutomationId="IncidentReview.UseSharedEventServer"
                                AutomationProperties.Name="Create a join code for an always-on shared server"
                                Command="{Binding UseSharedEventServerCommand}"
                                Content="Use shared server"
                                Style="{StaticResource AppToolbarButtonStyle}" />
                        <Button Grid.Row="1"
                                Grid.Column="3"
                                Margin="8,8,0,0"
                                AutomationProperties.AutomationId="IncidentReview.ToggleCustomEventSession"
                                AutomationProperties.Name="Start or stop a joinable custom event session"
                                Command="{Binding ToggleCustomEventSessionCommand}"
                                Content="{Binding State.CustomEventSessionActionText, StringFormat={}{0} locally}"
                                Style="{StaticResource AppToolbarButtonStyle}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Margin="0,7,0,0"
                                   Style="{StaticResource AppMutedTextStyle}"
                                   Text="Trusted local network only. Join codes do not provide authentication."
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Expander>

        <StatusBar Grid.Row="3"
                   AutomationProperties.AutomationId="IncidentReview.StatusBar">
            <StatusBarItem Padding="0" HorizontalContentAlignment="Stretch">
                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type StatusBar}}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="3,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="IncidentReview.ConnectionStatus"
                               AutomationProperties.Name="Simulator connection status"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding State.ConnectionStatus}" />
                    <Separator Grid.Column="1" Style="{StaticResource AppVerticalSeparatorStyle}" />
                    <TextBlock Grid.Column="2"
                               Margin="3,0"
                               VerticalAlignment="Center"
                               Text="{Binding State.StatusDetail}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding State.StatusDetail}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State.HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Separator Grid.Column="3" Style="{StaticResource AppVerticalSeparatorStyle}" />
                    <TextBlock Grid.Column="4"
                               Margin="3,0"
                               VerticalAlignment="Center"
                               Text="{Binding State.MonitoringStatus}" />
                    <Separator Grid.Column="5" Style="{StaticResource AppVerticalSeparatorStyle}" />
                    <Button Grid.Column="6"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="IncidentReview.CycleTheme"
                            AutomationProperties.HelpText="{Binding State.ThemeToolTip}"
                            AutomationProperties.Name="{Binding State.ThemeToolTip}"
                            Command="{Binding CycleThemeCommand}"
                            Style="{StaticResource AppIconButtonStyle}"
                            ToolTip="{Binding State.ThemeToolTip}">
                        <Grid Width="16" Height="16" IsHitTestVisible="False">
                            <Path Data="M 1,2 L 15,2 L 15,11 L 1,11 Z M 5,14 L 11,14 M 8,11 L 8,14"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.4">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.FollowsDesktopTheme}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M 8,3 A 5,5 0 1 1 7.99,13 A 5,5 0 1 1 8,3 M 8,0 L 8,2 M 8,14 L 8,16 M 0,8 L 2,8 M 14,8 L 16,8 M 2.3,2.3 L 3.7,3.7 M 12.3,12.3 L 13.7,13.7 M 13.7,2.3 L 12.3,3.7 M 3.7,12.3 L 2.3,13.7"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.35">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.UsesLightThemePreference}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M 11.7,1 C 7.1,1.8 4.6,6.9 6.8,10.9 C 8.5,14 12.4,15 15.1,12.7 C 12.1,12.9 9.4,10.9 8.8,8 C 8.2,5.4 9.4,2.8 11.7,1 Z"
                                  Fill="{DynamicResource PrimaryTextBrush}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.UsesDarkThemePreference}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
