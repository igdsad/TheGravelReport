[Unit]
Description=GravelReview custom-event synchronization server
Documentation=file:/opt/gravelreview-server/current/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gravelreview
Group=gravelreview
WorkingDirectory=/opt/gravelreview-server/current
ExecStart=/opt/gravelreview-server/current/IncidentReview.Host.Server
EnvironmentFile=-/etc/default/gravelreview-server
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=always
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
TasksMax=64
LimitNOFILE=4096
MemoryHigh=256M
MemoryMax=320M

# The service only needs its durable SQLite state and network access.
StateDirectory=gravelreview
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gravelreview
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
